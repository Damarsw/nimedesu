{
  "rewrites": [
    {
      "source": "/api-backend/:path*",
      "destination": "/api/proxy?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
